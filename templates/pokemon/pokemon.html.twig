{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ pokemon.nom }}
	- Détails
{% endblock %}

{% block content %}
	<h1>{{ pokemon.nom }}</h1>

	<div style="border: 1px solid #ddd; padding: 16px; margin-bottom: 20px;">
		<h3>Détails du Pokémon</h3>
		<ul>
			<li>
				<strong>Numéro Pokedex:</strong>
				{{ pokemon.numeroPokedex }}</li>
			<li>
				<strong>Nom:</strong>
				{{ pokemon.nom }}</li>
			<li>
				<strong>Type 1:</strong>
				{{ pokemon.type1.nom }}</li>
			<li>
				<strong>Type 2:</strong>
				{{ pokemon.type2 ? pokemon.type2.nom : '—' }}</li>
			<li>
				<strong>Talent:</strong>
				{{ pokemon.talent ? pokemon.talent.nom : '—' }}</li>
			<li>
				<strong>PV:</strong>
				{{ pokemon.pv }}</li>
			<li>
				<strong>Attaque:</strong>
				{{ pokemon.attaque }}</li>
			<li>
				<strong>Défense:</strong>
				{{ pokemon.defense }}</li>
			<li>
				<strong>Vitesse:</strong>
				{{ pokemon.vitesse }}</li>
			<li>
				<strong>Génération:</strong>
				{{ pokemon.generation }}</li>
		</ul>
	</div>

	<a href="{{ path('app_pokemon') }}">Retour à la liste des Pokémon</a>
{% endblock %}
