{% extends 'layouts/base.html.twig' %}

{% block title %}Page d'Accueil - Pokémon, F1 & Musique
{% endblock %}

{% block content %}
	<section class="pokemons">
		<h2>
			<a href="{{ path('app_pokemon') }}" style="text-decoration: none;">Pokémon</a>
		</h2>
		<ul>
			{% for pokemon in pokemons %}
				<li>{{ pokemon }}</li>
			{% endfor %}
		</ul>
	</section>

	<section class="f1">
		<h2>
			<a href="{{ path('app_formula_one') }}" style="text-decoration: none;">Formule 1</a>
		</h2>
		<ul>
			{% for team in f1_teams %}
				<li>{{ team }}</li>
			{% endfor %}
		</ul>
	</section>

	<section class="music">
		<h2>
			<a href="{{ path('app_music') }}" style="text-decoration: none;">Genres Musicaux</a>
		</h2>
		<ul>
			{% for genre in music_genres %}
				<li>{{ genre }}</li>
			{% endfor %}
		</ul>
	</section>
{% endblock %}
